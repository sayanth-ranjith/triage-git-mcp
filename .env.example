# Personal access token used to authenticate to the GitHub REST API.
# Classic PAT scope needed: repo (read access to issues, including
# private repos, across everywhere you have access).
GITHUB_TOKEN=

# Only needed for scripts/ask.py, which uses Claude as the MCP host so you
# can ask the server questions in plain English. Not used by the server.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
